# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Circle ───────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=...
CIRCLE_ENTITY_SECRET=...        # 32-byte hex, generate once and store securely
CIRCLE_WALLET_SET_ID=...        # Created in Circle Developer Console

# ─── Arc / Blockchain ─────────────────────────────────────────────────────────
ARC_RPC_URL=https://arc-testnet.g.alchemy.com/v2/alch_cojzcvLgQaWVcCE2BWXpp
DEPLOYER_PRIVATE_KEY=0x...      # Wallet that deploys contracts. Also acts as the sole orchestrator signer if ORCHESTRATOR_PRIVATE_KEYS is not set.

# How many tasks' full pipelines run concurrently, platform-wide (see
# taskQueue.service.ts). Tune against your actual LLM provider's tokens/
# minute limit — too high and tasks will queue behind rate-limit backoffs
# instead of running smoothly. Defaults to 5 if unset.
# WORKER_CONCURRENCY=5

# Optional — for scaling concurrent on-chain signing beyond a single wallet's
# sequential nonce. Comma-separated private keys; EVERY wallet listed here
# must hold ORCHESTRATOR_ROLE on the deployed OrchestratorEscrow contract
# (grant it via contracts/scripts/deploy.ts's ORCHESTRATOR_ADDRESSES at
# deploy time, or later with onChainService.grantOrchestratorRole()).
# If unset, falls back to DEPLOYER_PRIVATE_KEY as a single signer.
# ORCHESTRATOR_PRIVATE_KEYS=0x...,0x...,0x...

# Optional — comma-separated addresses to grant ORCHESTRATOR_ROLE to at
# deploy time (contracts/scripts/deploy.ts reads this). Should match the
# addresses derived from ORCHESTRATOR_PRIVATE_KEYS above.
# ORCHESTRATOR_ADDRESSES=0x...,0x...,0x...

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001/ws
